{
  "manifest_version": 3,
  "name": "ANDROMEDA Downloader Integration",
  "version": "1.0.0",
  "description": "Integración de alta velocidad para capturar enlaces y videos con ANDROMEDA DOWNLOAD.",
  "permissions": [
    "downloads",
    "contextMenus",
    "activeTab",
    "scripting",
    "storage"
  ],
  "host_permissions": [
    "*://*/*",
    "http://127.0.0.1/*",
    "http://localhost/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": ["*://*/*"],
      "js": ["content_video.js"],
      "css": ["estilos_overlay.css"],
      "run_at": "document_idle"
    }
  ],
  "action": {
    "default_title": "Andromeda Download",
    "default_icon": {
      "16": "iconos/icon16.png",
      "48": "iconos/icon48.png",
      "128": "iconos/icon128.png"
    }
  },
  "icons": {
    "16": "iconos/icon16.png",
    "48": "iconos/icon48.png",
    "128": "iconos/icon128.png"
  },
  "web_accessible_resources": [
    {
      "resources": ["iconos/*"],
      "matches": ["*://*/*"]
    }
  ]
}
